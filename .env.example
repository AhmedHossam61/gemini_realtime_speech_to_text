GOOGLE_API_KEY=your-api-key-here
CHUNK_DURATION_SEC=5
# Choose output language:
# - English: TARGET_LANGUAGE=English
# - Arabic:  TARGET_LANGUAGE=Arabic
TARGET_LANGUAGE=English

# Source language:
# - auto: let Gemini detect spoken language automatically
# - or set a fixed source (examples: English, Arabic)
SOURCE_LANGUAGE=auto
OUTPUT_FILE=translation_output.txt
MODEL_NAME=gemini-2.0-flash
SAMPLE_RATE=16000
CHANNELS=1
FRAMES_PER_BUFFER=1024
SILENCE_RMS_THRESHOLD=20.0
# Troubleshooting:
# - If you keep seeing no transcription, lower threshold (example: 20 or 10)
# - Set DEBUG_AUDIO=true to print RMS and raw transcription details
DEBUG_AUDIO=true
